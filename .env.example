# AI Web Engine Server Configuration
# Copy this file to .env and configure for your environment
# Most defaults point to softagen.com - change SERVER_HOST / MANAGE_HOST to use
# a different server

# Server host (the engine's default host for deployed solutions)
SERVER_HOST=https://softagen.com

# Management host (engine HTTP API under /engine/..., the MCP endpoint /mcp, the
# authenticated GraphQL endpoint /graphql and OAuth discovery)
MANAGE_HOST=https://manage.softagen.com

# Hostname the virtual-world example is published on (see `make set-script-hosts`)
WORLD_HOST=world.softagen.com

# API endpoints (derived from MANAGE_HOST)
API_TYPES_BASE_URL=${MANAGE_HOST}/engine/types/v0.1.0
OPENAPI_URL=${MANAGE_HOST}/engine/openapi.json
MCP_URL=${MANAGE_HOST}/mcp

# OAuth Configuration
OAUTH_ISSUER=${MANAGE_HOST}
OAUTH_CLIENT_ID=
OAUTH_SCOPE=openid
OAUTH_REDIRECT_HOST=127.0.0.1
OAUTH_REDIRECT_PORT=0

# GraphQL Configuration
SCHEMA_ENDPOINT=${MANAGE_HOST}/graphql
GRAPHQL_METHOD=POST
# GRAPHQL_COOKIE=
# GRAPHQL_REFERER=
# CSRF_TOKEN=

# Authentication Tokens (generated by oauth-login script)
# OAUTH_TOKEN=
# BEARER_TOKEN=
